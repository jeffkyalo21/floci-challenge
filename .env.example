# Floci (AWS Emulator) — Environment Variables
# Copy this file to .env and adjust if needed.

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

